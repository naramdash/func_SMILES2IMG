    <RepositoryUrl>https://github.com/naramdash/func_SMILES2IMG</RepositoryUrl>
    <DistributionRoot Condition="'$(DistributionRoot)' == ''">$(MSBuildThisFileDirectory)dist</DistributionRoot>
  </PropertyGroup>
</Project>
