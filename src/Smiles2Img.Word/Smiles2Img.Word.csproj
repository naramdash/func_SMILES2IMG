<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>Smiles2Img.Word</AssemblyName>
    <RootNamespace>Smiles2Img.Word</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smiles2Img.Core\Smiles2Img.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Office.Interop.Word" Version="15.0.4797.1004" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <Target Name="CopyToDistribution" AfterTargets="Build">
    <MakeDir Directories="$(DistributionRoot)/x64/Word;$(DistributionRoot)/x86/Word" />
    <ItemGroup>
      <OutputFiles Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(OutputFiles)" DestinationFolder="$(DistributionRoot)/x64/Word" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(OutputFiles)" DestinationFolder="$(DistributionRoot)/x86/Word" SkipUnchangedFiles="true" />
  </Target>
</Project>
