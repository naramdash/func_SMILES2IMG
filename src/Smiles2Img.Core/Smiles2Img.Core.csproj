<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Smiles2Img.Core</AssemblyName>
    <RootNamespace>Smiles2Img</RootNamespace>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Indigo.Net" Version="1.49.0-rc.2" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets/ketcher.zip" LogicalName="Smiles2Img.Ketcher.zip" />
    <EmbeddedResource Include="$(PkgIndigo_Net)/runtimes/win-x64/native/*.dll"
                      Exclude="$(PkgIndigo_Net)/runtimes/win-x64/native/bingo-nosql.dll"
                      LogicalName="Smiles2Img.Native.x64.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PkgIndigo_Net)/runtimes/win-x86/native/*.dll"
                      Exclude="$(PkgIndigo_Net)/runtimes/win-x86/native/bingo-nosql.dll;$(PkgIndigo_Net)/runtimes/win-x86/native/vcruntime140_1.dll"
                      LogicalName="Smiles2Img.Native.x86.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)/runtimes/win-x64/native/WebView2Loader.dll"
                      LogicalName="Smiles2Img.Native.x64.WebView2Loader.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)/runtimes/win-x86/native/WebView2Loader.dll"
                      LogicalName="Smiles2Img.Native.x86.WebView2Loader.dll" />
  </ItemGroup>
</Project>
