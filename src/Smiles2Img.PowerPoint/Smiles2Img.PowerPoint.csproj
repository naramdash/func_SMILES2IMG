<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>Smiles2Img.PowerPoint</AssemblyName>
    <RootNamespace>Smiles2Img.PowerPoint</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <NoWarn>$(NoWarn);1762</NoWarn>
    <DistributionRoot Condition="'$(DistributionRoot)' == ''">$(MSBuildProjectDirectory)/../../dist</DistributionRoot>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smiles2Img.Core\Smiles2Img.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Office.Interop.PowerPoint" Version="15.0.4420.1018" EmbedInteropTypes="false" />
    <PackageReference Include="ExcelDna.Interop" Version="16.0.0" EmbedInteropTypes="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <Target Name="CopyToDistribution" AfterTargets="Build">
    <MakeDir Directories="$(DistributionRoot)/x64/PowerPoint;$(DistributionRoot)/x86/PowerPoint" />
    <ItemGroup>
      <OutputFiles Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(OutputFiles)" DestinationFolder="$(DistributionRoot)/x64/PowerPoint" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(OutputFiles)" DestinationFolder="$(DistributionRoot)/x86/PowerPoint" SkipUnchangedFiles="true" />
  </Target>

</Project>
